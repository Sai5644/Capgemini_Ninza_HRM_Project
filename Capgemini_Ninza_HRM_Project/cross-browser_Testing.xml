<?xml version="1.0" encoding="UTF-8"?>

<suite name="Ninza HRM Cross Browser Suite" thread-count="2">

    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="ecom.ninzahrm.Login.LoginTest"/>
            <class name="ecom.ninzahrm.Employee.EmployeeTest"/>
            <class name="ecom.ninzahrm.Dashboard.DashboardTest"/>
            <class name="ecom.ninzahrm.Resources.ResourcesTest"/>
        </classes>
    </test>

    <test name="Edge Tests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="ecom.ninzahrm.Login.LoginTest"/>
            <class name="ecom.ninzahrm.Employee.EmployeeTest"/>
            <class name="ecom.ninzahrm.Dashboard.DashboardTest"/>
            <class name="ecom.ninzahrm.Resources.ResourcesTest"/>
        </classes>
    </test>

</suite>
